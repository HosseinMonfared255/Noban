// ===========================================================
// Noban — Database Schema
// سامانه هوشمند رزرو نوبت پزشک
//
// طراحی‌شده برای: ۵۰ پزشک، ۲۰ هزار کاربر
// سازگار با SQLite (فعلی) و PostgreSQL (آینده)
// ===========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================
// ۱. کاربران — بیماران عادی سایت
// ===========================================================
model User {
  id           String   @id @default(cuid())
  phone        String   @unique // شماره موبایل (کلید یکتا)
  passwordHash String? // هش رمز عبور (null = فقط OTP)
  firstName    String
  lastName     String
  avatar       String? // URL تصویر پروفایل
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // روابط
  appointments  Appointment[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  loginEvents   LoginEvent[]
  otpCodes      OtpCode[]

  @@index([phone])
}

// ===========================================================
// ۲. پزشکان
// ===========================================================
model Doctor {
  id          String   @id @default(cuid())
  slug        String   @unique // URL slug (مثلا "دکتر-سارا-محمدی")
  firstName   String
  lastName    String
  fullName    String // "دکتر سارا محمدی" (برای نمایش)
  specialtyId String // ارتباط با تخصص
  photo       String // URL عکس
  phone       String // تلفن مطب
  address     String // آدرس کامل
  location    String // نام محل مطب (مثلا "مطب ولیعصر")
  lat         Float?
  lng         Float?
  about       String // توضیحات
  experience  Int // سال‌های تجربه
  fee         Int // تعرفه ویزیت (تومان)
  rating      Float    @default(0) // امتیاز میانگین (محاسبه‌شده)
  reviewCount Int      @default(0) // تعداد نظرات (محاسبه‌شده)
  isActive    Boolean  @default(true) // آیا پزشک فعال است؟
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // روابط
  specialty      Specialty      @relation(fields: [specialtyId], references: [id])
  availabilities Availability[]
  appointments   Appointment[]
  reviews        Review[]
  favorites      Favorite[]

  @@index([specialtyId])
  @@index([isActive])
}

// ===========================================================
// ۳. تخصص‌های پزشکی
// ===========================================================
model Specialty {
  id          String   @id @default(cuid())
  name        String   @unique // "قلب و عروق"
  icon        String // ایموجی یا نام آیکون
  doctorCount Int      @default(0) // تعداد پزشکان (محاسبه‌شده)
  sortOrder   Int      @default(0) // ترتیب نمایش
  createdAt   DateTime @default(now())

  // روابط
  doctors Doctor[]

  @@index([sortOrder])
}

// ===========================================================
// ۴. نوبت‌ها — رزروهای پزشکی
// ===========================================================
model Appointment {
  id           String   @id @default(cuid())
  trackingCode String   @unique // کد رهگیری (۵ رقمی)
  userId       String // کاربر رزروکننده
  doctorId     String // پزشک موردنظر
  dayName      String // "شنبه"
  date         String // "۱۸ مرداد" (تاریخ شمسی)
  slot         String // "۰۹:۰۰" (ساعت)
  patientName  String // نام بیمار
  patientPhone String // تلفن بیمار
  insurance    String   @default("بیمه پایه") // نوع بیمه
  fee          Int // مبلغ ویزیت (در زمان رزرو)
  status       String   @default("upcoming") // upcoming | completed | cancelled
  cancelReason String? // دلیل لغو (در صورت وجود)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // روابط
  user   User   @relation(fields: [userId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@index([userId, status])
  @@index([doctorId, status])
  @@index([date, slot])
}

// ===========================================================
// ۵. نظرات کاربران روی پزشکان
// ===========================================================
model Review {
  id        String   @id @default(cuid())
  userId    String
  doctorId  String
  rating    Int // ۱ تا ۵
  text      String // متن نظر
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // محدودیت: هر کاربر فقط یک نظر روی هر پزشک
  user   User   @relation(fields: [userId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([userId, doctorId])
  @@index([doctorId])
}

// ===========================================================
// ۶. علاقه‌مندی‌ها — پزشکان ذخیره‌شده توسط کاربر
// ===========================================================
model Favorite {
  userId    String
  doctorId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@id([userId, doctorId])
  @@index([userId])
}

// ===========================================================
// ۷. اعلان‌ها — یادآوری‌ها و پیام‌های سیستم
// ===========================================================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // appointment_reminder | review_reply | health_tip | promotion
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

// ===========================================================
// ۸. تاریخچه ورود — برای امنیت حساب
// ===========================================================
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  method    String // password | otp | signup
  device    String // "دسکتاپ · ویندوز · Chrome"
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ===========================================================
// ۹. کدهای یکبار مصرف (OTP)
// ===========================================================
model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  code      String // کد ۶ رقمی
  purpose   String   @default("login") // login | signup | reset_password
  expiresAt DateTime // زمان انقضا (معمولا ۲ دقیقه)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isUsed])
  @@index([expiresAt])
}

// ===========================================================
// ۱۰. زمان‌بندی پزشک — ساعات کاری هفتگی
// ===========================================================
model Availability {
  id           String   @id @default(cuid())
  doctorId     String
  dayOfWeek    Int // ۰=شنبه، ۱=یکشنبه، ... ۶=جمعه
  startTime    String // "09:00"
  endTime      String // "18:00"
  slotDuration Int      @default(30) // مدت هر نوبت (دقیقه)
  isClosed     Boolean  @default(false) // آیا این روز تعطیل است؟
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
}
